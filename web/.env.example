# Names only - no secrets. Copy to .env.local.
# 1 = run with built-in sample data, no backend needed.
NEXT_PUBLIC_USE_FAKE_API=1
# Base address of the FastAPI backend (routes live under /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Placeholder product name - read from config, never hard-coded (CLAUDE.md section 1).
NEXT_PUBLIC_PRODUCT_NAME=
# Data snapshot label shown until a response carries its own data-as-of date.
NEXT_PUBLIC_DATA_SNAPSHOT=v2026.08
