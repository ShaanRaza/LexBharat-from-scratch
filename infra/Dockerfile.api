# One image for the API and the worker. Multi-arch base: runs on ARM (Graviton r7g)
# and x86 laptops. Build for the server with: docker buildx build --platform linux/arm64
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    ALEMBIC_CONFIG=/app/migrations/alembic.ini
WORKDIR /app

COPY pyproject.toml ./
COPY api ./api
COPY core ./core
COPY adapters ./adapters
COPY workers ./workers
COPY data ./data
COPY migrations ./migrations
# The `search` extra is REQUIRED: it brings fastembed, the keyword (BM25) half of hybrid
# search. Without it every search raises VectorStoreUnavailable and every question ends
# as an error (adapters/qdrant.py FastEmbedBm25). A114.
RUN pip install --no-cache-dir ".[search]"

RUN useradd --create-home --uid 10001 app && chown -R app /app
USER app
EXPOSE 8000
CMD ["uvicorn", "api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
